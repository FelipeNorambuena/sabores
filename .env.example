# Copia este archivo a .env y completa las claves. NUNCA subas .env al repositorio (ya está en .gitignore).

# --- Modelo de lenguaje (cualquier API compatible con OpenAI; aquí, Groq) ---
LLM_PROVEEDOR=groq
LLM_API_KEY=gsk_tu_clave_de_groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO_PLANIFICADOR=openai/gpt-oss-120b
LLM_MODELO_EJECUTOR=openai/gpt-oss-120b

# --- Embeddings: Groq no ofrece embeddings, se usan los de Gemini (solo para la búsqueda en FAISS) ---
EMBEDDINGS_PROVEEDOR=google
GOOGLE_API_KEY=tu_clave_de_google_ai_studio

# --- Comportamiento del agente (opcionales) ---
# Perfil: baseline (EV2 tal cual, por defecto) u optimizado (cambios de la EV3). Ver docs/diseno.md, diagrama 6.
AGENTE_PERFIL=baseline
# Ritmo del limitador propio de llamadas al modelo (por defecto 8; con Groq se puede subir a 30)
LLM_LLAMADAS_POR_MINUTO=30
